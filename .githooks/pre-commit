#!/bin/sh
#
# Warn (do not block) when there are untracked files under src/ that aren't part
# of this commit. New files are NOT swept in by `git commit -a`/`-am` — they must
# be `git add`ed explicitly — so they can quietly sit uncommitted for days.
# See: brand-new admin screens that lived only on a laptop for ~a week.

untracked=$(git ls-files --others --exclude-standard -- src/)

if [ -n "$untracked" ]; then
  printf '\n\033[33m⚠  Untracked files under src/ are NOT in this commit:\033[0m\n'
  printf '%s\n' "$untracked" | sed 's/^/     /'
  printf '\033[33m   If these belong in the commit, run: git add <file> (or git add -A) and re-commit.\033[0m\n\n'
fi

# ── Does every screen this commit touches still OPEN? ─────────────────────────
# The gate that catches what reading the source cannot: a build that compiles,
# tests that pass, and a blank page. Two of those shipped in a week.
#
# --changed, not everything. All 49 screens is a couple of minutes, and a couple
# of minutes per commit gets answered with --no-verify — which is exactly what
# happened six times in one afternoon on this repo. A commit that touches one
# screen pays for one screen; a commit that touches anything SHARED pays for all
# of them, because nothing can honestly say which screens a shared change reaches.
#
# Skips silently when no session is saved (`npm run check:smoke -- --login`), so
# nobody is blocked from committing by a setup step they have not done yet.
if ! npm run --silent check:smoke -- --changed; then
  printf '\n\033[31m✗ A screen in this commit does not open.\033[0m\n'
  printf '   Fix it, or commit with --no-verify if you know why it is broken.\n\n'
  exit 1
fi

exit 0
